{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room_id": {
        ".read": "data.exists() && now < data.child('info/createdAt').val() + 86400000",
        ".write": "!data.exists() || (data.exists() && now < data.child('info/createdAt').val() + 86400000)",
        "logs": {
          "$log_id": {
            "msg": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 300"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    }
  }
}